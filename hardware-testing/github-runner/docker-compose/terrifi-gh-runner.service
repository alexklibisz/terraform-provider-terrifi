# Keeps supervise.sh running, which starts one fresh runner container per job.
# Install with the commands in ../README.md.
[Unit]
Description=Terrifi GitHub Actions runner, one container per job
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=terrifi
WorkingDirectory=/home/terrifi/docker-compose
ExecStart=/home/terrifi/docker-compose/supervise.sh
Restart=always
RestartSec=10
# Signal only supervise.sh, so it can stop the container gracefully. Allow
# the 5 minute stop_grace_period plus some slack before killing everything.
KillMode=mixed
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
