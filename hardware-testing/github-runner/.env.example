# URL of the repository this runner will serve
# e.g. https://github.com/your-org/terraform-provider-terrifi
REPO_URL=https://github.com/your-org/terraform-provider-terrifi

# Fine-grained personal access token with Administration read and write on
# this repository. The supervisor uses it to register one single-use runner
# per job; runner containers never see it. Never use a classic token.
# See README.md for how to create it.
ACCESS_TOKEN=github_pat_your-fine-grained-token

# Optional overrides (defaults shown)
# RUNNER_NAME=terrifi-hardware-runner
# LABELS=self-hosted,terrifi-hardware-test
# LAN address that runner containers resolve unifi.local to
# CONTROLLER_LAN_IP=192.168.1.3
