# Source a private copy of this file before running Task. Task does not load it.
export TERRIFI_STATE_BUCKET="<private-r2-bucket>"
export AWS_ENDPOINT_URL_S3="https://<account-id>.r2.cloudflarestorage.com"
export AWS_ACCESS_KEY_ID="<r2-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"

export UNIFI_API="https://<hil-controller>:11443"
export UNIFI_API_KEY="<hil-api-key>"
export UNIFI_INSECURE=true
export UNIFI_SITE=default
